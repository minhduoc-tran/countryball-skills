{
 "id": "TypeOne",
 "slug": "type-one",
 "topic": "Nếu ngày mai nhân loại trở thành nền văn minh cấp I?",
 "title": [
  "NẾU NGÀY MAI",
  "NHÂN LOẠI ĐẠT CẤP I?"
 ],
 "script": [
  {
   "beat": "1",
   "text": "Bạn thức dậy. Cả thành phố sáng rực."
  },
  {
   "beat": "2",
   "text": "Máy lạnh chạy. Xe sạc. Điện vẫn dư."
  },
  {
   "beat": "3",
   "text": "Một mạng năng lượng nối cả hành tinh."
  },
  {
   "beat": "4",
   "text": "Nhưng ai đang giữ công tắc?"
  },
  {
   "beat": "5",
   "text": "Nếu ngày mai, nhân loại đạt cấp I?"
  },
  {
   "beat": "6",
   "text": "Đây là thang đo khả năng dùng năng lượng."
  },
  {
   "beat": "7",
   "text": "Ta chọn mốc cấp I: mười triệu tỷ watt."
  },
  {
   "beat": "8",
   "text": "Đó là công suất, không phải kho điện vô hạn."
  },
  {
   "beat": "9",
   "text": "Cấp I gắn với quy mô hành tinh."
  },
  {
   "beat": "10",
   "text": "Cấp II và III lớn hơn rất nhiều."
  },
  {
   "beat": "11",
   "text": "Giả sử cả hạ tầng cũng xuất hiện qua đêm."
  },
  {
   "beat": "12",
   "text": "Nguồn điện sạch hoạt động khắp nơi."
  },
  {
   "beat": "13",
   "text": "Đường dây, lưu trữ và điều phối đều sẵn sàng."
  },
  {
   "beat": "14",
   "text": "Bạn bước vào một ngày chưa từng có."
  },
  {
   "beat": "15",
   "text": "Biển có thể trở thành nguồn nước ngọt."
  },
  {
   "beat": "16",
   "text": "Bơm ép nước qua màng, giữ muối lại."
  },
  {
   "beat": "17",
   "text": "Nhà kính có thêm điện cho đèn và bơm."
  },
  {
   "beat": "18",
   "text": "Nhưng cây vẫn cần đất, chất dinh dưỡng, thời gian."
  },
  {
   "beat": "19",
   "text": "Bệnh viện bớt lo thiếu điện vận hành."
  },
  {
   "beat": "20",
   "text": "Em gái bạn không còn học dưới đèn yếu."
  },
  {
   "beat": "21",
   "text": "Xe điện và tàu điện có thêm nguồn cấp."
  },
  {
   "beat": "22",
   "text": "Nhà máy có thể điện hóa nhiều công đoạn."
  },
  {
   "beat": "23",
   "text": "Robot làm việc. Con người đổi nghề."
  },
  {
   "beat": "24",
   "text": "Hóa đơn điện có thể giảm."
  },
  {
   "beat": "25",
   "text": "Nhưng giá điện còn do luật và thị trường."
  },
  {
   "beat": "26",
   "text": "Nước sạch vẫn cần đường ống và bảo trì."
  },
  {
   "beat": "27",
   "text": "Thực phẩm vẫn cần được vận chuyển."
  },
  {
   "beat": "28",
   "text": "Có đủ điện chưa chắc ai cũng được dùng."
  },
  {
   "beat": "29",
   "text": "Một nơi dư điện, nơi khác thiếu kết nối."
  },
  {
   "beat": "30",
   "text": "Cấp I là năng lượng, không phải công bằng."
  },
  {
   "beat": "31",
   "text": "Rồi bạn nhận ra: năng lượng đi về đâu?"
  },
  {
   "beat": "32",
   "text": "Khi sử dụng, phần lớn cuối cùng thành nhiệt."
  },
  {
   "beat": "33",
   "text": "Trái Đất nhận nắng và tỏa nhiệt ra ngoài."
  },
  {
   "beat": "34",
   "text": "Thêm nguồn nhiệt ròng sẽ đổi cân bằng ấy."
  },
  {
   "beat": "35",
   "text": "Mười triệu tỷ watt chia đều bề mặt..."
  },
  {
   "beat": "36",
   "text": "...xấp xỉ hai mươi watt mỗi mét vuông."
  },
  {
   "beat": "37",
   "text": "Đó là phép tính minh họa, không phải dự báo."
  },
  {
   "beat": "38",
   "text": "Thu ánh nắng vốn tới Trái Đất khác nguồn mới."
  },
  {
   "beat": "39",
   "text": "Khử mặn cũng để lại nước muối đậm đặc."
  },
  {
   "beat": "40",
   "text": "Công suất lớn cần giới hạn sinh thái lớn tương ứng."
  },
  {
   "beat": "41",
   "text": "Bạn không thể bấm nút xóa mọi cơn bão."
  },
  {
   "beat": "42",
   "text": "Cấp I không chứng minh khả năng điều khiển thời tiết."
  },
  {
   "beat": "43",
   "text": "Một trung tâm muốn nối mọi thứ vào nó."
  },
  {
   "beat": "44",
   "text": "Càng liên kết, lỗi càng cần được cô lập."
  },
  {
   "beat": "45",
   "text": "Trong kịch bản này, một vùng bất ngờ tắt điện."
  },
  {
   "beat": "46",
   "text": "Bệnh viện chuyển sang nguồn dự phòng."
  },
  {
   "beat": "47",
   "text": "Nhà em gái bạn cũng chìm vào tối."
  },
  {
   "beat": "48",
   "text": "Bạn có quyền chọn cách chia phần điện còn lại."
  },
  {
   "beat": "49",
   "text": "Giữ đặc quyền, hay ưu tiên nhu cầu thiết yếu?"
  },
  {
   "beat": "50",
   "text": "Bạn chọn mạng dự phòng và quyền tiếp cận."
  },
  {
   "beat": "51",
   "text": "Ánh sáng trở lại, từng khu phố một."
  },
  {
   "beat": "52",
   "text": "Em gái bạn mở lại cuốn sách."
  },
  {
   "beat": "53",
   "text": "Nhiều năng lượng mở ra nhiều khả năng."
  },
  {
   "beat": "54",
   "text": "Nó không tự xóa chiến tranh hay bất bình đẳng."
  },
  {
   "beat": "55",
   "text": "Và không biến nhân loại thành bất tử."
  },
  {
   "beat": "56",
   "text": "Ta còn phải giữ hành tinh có thể sống được."
  },
  {
   "beat": "57",
   "text": "Một nền văn minh lớn biết kiểm soát chính mình."
  },
  {
   "beat": "58",
   "text": "Đạt cấp I chỉ là vượt một mốc năng lượng."
  },
  {
   "beat": "59",
   "text": "Điều quan trọng: cuộc sống của ai tốt hơn?"
  },
  {
   "beat": "60",
   "text": "Ngày mai có đủ điện. Ta đã đủ trưởng thành chưa?"
  }
 ],
 "science": [
  {
   "claim": "Mốc cấp I được chọn là 10^16 W theo cách nội suy phổ biến; không đồng nhất với mọi định nghĩa lịch sử.",
   "working": "K=(log10(P)-6)/10; K=1 => P=10^16 W.",
   "source": "https://www.nature.com/articles/s41598-023-38351-y"
  },
  {
   "claim": "Minh họa nhiệt thải bổ sung khoảng 20 W/m².",
   "working": "Giả sử 10^16 W là nhiệt ròng mới và chia đều diện tích 4*pi*(6.371e6)^2 =5.10e14 m²: 19.6 W/m². Không là dự báo nhiệt độ; ánh nắng thu lại khác nguồn nhiệt mới.",
   "source": "https://science.nasa.gov/earth/earth-observatory/climate-and-earths-energy-budget/"
  },
  {
   "claim": "Thẩm thấu ngược dùng bơm áp lực, tạo nước ngọt và nước muối đậm đặc.",
   "working": "Chỉ mô tả cơ chế, không khẳng định cấp I loại bỏ mọi chi phí hoặc tác động môi trường.",
   "source": "https://www.energy.gov/cmei/ito/desalination-basics"
  }
 ],
